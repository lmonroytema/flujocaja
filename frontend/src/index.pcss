@import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap");

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  font-family: "IBM Plex Sans", sans-serif;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  color: rgba(255, 255, 255, 0.92);
  background:
    radial-gradient(circle at top left, rgba(55, 176, 198, 0.14), transparent 24%),
    radial-gradient(circle at top right, rgba(41, 211, 145, 0.12), transparent 20%),
    linear-gradient(145deg, #060b12 0%, #0b1220 38%, #111b2d 100%);
}

* {
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
}

body {
  min-width: 320px;
  overflow-x: hidden;
}

#root {
  min-height: 100vh;
}

input[type="number"]::-webkit-outer-spin-button,
input[type="number"]::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
